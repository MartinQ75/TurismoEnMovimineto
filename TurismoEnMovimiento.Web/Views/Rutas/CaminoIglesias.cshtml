            Imagen = "11 estacion.jpg"
        },
        new {
            Numero = 12,
            Nombre = "Iglesia de La Madrid - Nuestra Señora del Rosario",
            Imagen = "12 estacion.jpg"
        },
        new {
            Numero = 13,
            Nombre = "La Vega",
            Imagen = "REEMPLAZAR-ESTACION-13.jpg"
        },
        new {
            Numero = 14,
            Nombre = "Virgen del Carmen - Puerto Canita de la Montaña",
            Imagen = "REEMPLAZAR-ESTACION-14.jpg"
