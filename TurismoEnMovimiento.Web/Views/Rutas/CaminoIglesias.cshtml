        },
        new {
            Numero = 4,
            Nombre = "Iglesia de San Francisco de Asís",
            Imagen = "cuarta estacion.jpg"
        },
        new {
            Numero = 5,
            Nombre = "Cristo de la Bartola Alumbrada",
            Imagen = "quinta estacion.jpg"
        },
        new {
            Numero = 6,
