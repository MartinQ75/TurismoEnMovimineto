            Imagen = "REEMPLAZAR-ESTACION-07.jpg"
        },
        new {
            Numero = 8,
            Nombre = "Santo Niño de la Cruz",
            Imagen = "REEMPLAZAR-ESTACION-08.jpg"
        },
        new {
            Numero = 9,
