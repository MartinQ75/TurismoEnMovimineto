@{
    ViewData["Title"] = "Inicio";
}

<!-- PORTADA -->
<section class="hero-principal" id="inicio">
    <div class="container">
        <div class="hero-contenedor">
            <div class="hero-contenido">
                <span class="hero-etiqueta">TURISMO · CULTURA · EXPERIENCIAS</span>

                <h1>Descubre experiencias que dejan huella</h1>

                <p>
                    Conoce nuestros eventos, descubre nuevos destinos
                    y disfruta de la riqueza turística y cultural de nuestra región.
                </p>

                <a href="#eventos" class="btn btn-principal">
                    Descubrir eventos
                </a>
            </div>

            <a asp-controller="Rutas"
                asp-action="CaminoIglesias"
                class="hero-imagen">

                <img src="~/Images/Camino-de-las-iglesias/Estaciones/16 estacion.jpg" 
                alt="Camino de las iglesias" />

                <span class="hero-imagen-texto">
                    Descubre el Camino de las Iglesias
                </span>
            </a>
        </div>
    </div>
</section>

<partial name="Patrocinadores">

<!-- EVENTOS -->
<section class="seccion-principal" id="eventos">
    <div class="container">

        <div class="encabezado-seccion">
            <span class="texto-etiqueta">VIVE NUESTRAS EXPERIENCIAS</span>
            <h2>Próximos eventos</h2>
            <p>
                Descubre las actividades que tenemos preparadas para ti.
            </p>
        </div>

        <div class="row g-4">

            <!-- EL GRAN ABRAZO -->
            <div class="col-md-4">
                <article class="tarjeta-evento">
                    <div class="contenedor-imagen-evento">
                        <img src="~/images/gran-abrazo/El gran abrazo.jpeg"
                             alt="Evento El Gran Abrazo"
                             class="imagen-evento" />
                    </div>

                    <div class="contenido-tarjeta">
                        <span class="categoria-evento">EVENTO CULTURAL</span>
                        <h3>El Gran Abrazo</h3>
                        <p>
                            Conoce esta experiencia y descubre todos los detalles
                            de nuestra celebración.
                        </p>
                         <a asp-controller="Eventos"
                         asp-action="GranAbrazo"
                         class="enlace-detalles">
                            Conocer más →
                         </a>
                    </div>
                </article>
            </div>

            <!-- FESTIVAL DE PAPALOTES -->
            <div class="col-md-4">
                <article class="tarjeta-evento">
                    <div class="contenedor-imagen-evento">
                        <img src="~/images/papalotes/Festival del papalote.jpeg"
                             alt="Festival de Papalotes"
                             class="imagen-evento" />
                    </div>

                    <div class="contenido-tarjeta">
                        <span class="categoria-evento">FESTIVAL</span>
                        <h3>Festival de Papalotes</h3>
                        <p>
                            Disfruta de una experiencia llena de color,
                            creatividad y diversión.
                        </p>
                        <a asp-controller="Eventos"
                        asp-action="Papalotes"
                        class="enlace-detalles">
                        Conocer más →
                    </a>
                    </div>
                </article>
            </div>

            <!-- FESTIVAL DEL GLOBO -->
            <div class="col-md-4">
                <article class="tarjeta-evento">
                    <div class="contenedor-imagen-evento">
                        <img src="~/images/Festival-Globo/Festivla del globo.jpeg"
                             alt="Festival del Globo"
                             class="imagen-evento" />
                    </div>

                    <div class="contenido-tarjeta">
                        <span class="categoria-evento">FESTIVAL</span>
                        <h3>Festival del Globo</h3>
                        <p>
                            Vive una experiencia diferente y conoce
                            los detalles de este festival.
                        </p>
                        <a asp-controller="Eventos"
                           asp-action="Globos"
                           class="enlace-detalles">
                            Conocer más →
                        </a>
                    </div>
                </article>
            </div>

        </div>
    </div>
</section>

<!-- RUTAS TURÍSTICAS -->
<section class="seccion-rutas" id="rutas">
    <div class="container">

        <div class="encabezado-seccion">
            <span class="texto-etiqueta">DESCUBRE NUESTRA REGIÓN</span>
            <h2>Explora nuestras rutas turísticas</h2>
            <p>
                Conoce lugares, historias y experiencias que forman
                parte de la riqueza de nuestra región.
            </p>
        </div>

        <div class="row g-4">

            <!-- CAMINO DE LAS IGLESIAS -->
            <div class="col-md-6">
                <article class="tarjeta-ruta">
                    <img src="~/images/Camino-de-las-iglesias/Ruta del desierto.jpeg"
                         alt="Iglesia que forma parte de un recorrido turístico"
                         class="imagen-ruta" />

                    <div class="contenido-ruta">
                        <h3>Camino de las Iglesias</h3>
                        <p>
                            Conoce el patrimonio histórico, arquitectónico
                            y cultural de nuestras comunidades.
                        </p>
                        <a asp-controller="Rutas"
                        asp-action="CaminoIglesias"
                        class="enlace-detalles">
                            Explorar ruta →
                        </a>
                    </div>
                </article>
            </div>

        </div>
    </div>
</section>
