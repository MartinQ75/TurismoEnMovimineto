@{
    ViewData["Title"] = "El Gran Abrazo";
}

<!-- =====================================
     PORTADA DEL EVENTO
     ===================================== -->

<section class="evento-hero">

    <!-- REEMPLAZAR POR LA FOTOGRAFÍA PRINCIPAL -->
    <div class="evento-hero-imagen"
         style="background-image: linear-gradient(rgba(15, 45, 35, 0.65), rgba(15, 45, 35, 0.65)), url('/images/gran-abrazo/REEMPLAZAR-IMAGEN-PORTADA.jpg');">

        <div class="container evento-hero-contenido">

            <span class="evento-etiqueta">
                EVENTO CULTURAL
            </span>

            <h1>El Gran Abrazo</h1>

            <!-- AGREGAR UNA FRASE REPRESENTATIVA DEL EVENTO -->
            <p>
                [AGREGAR FRASE O DESCRIPCIÓN BREVE DEL EVENTO]
            </p>

            <a href="#informacion" class="btn btn-principal">
                Conocer el evento
            </a>

        </div>
    </div>

</section>


<!-- =====================================
     DESCRIPCIÓN Y OBJETIVO
     ===================================== -->

<section class="evento-seccion" id="descripcion">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">CONOCE EL EVENTO</span>

            <h2>¿Qué es El Gran Abrazo?</h2>
        </div>

        <div class="evento-descripcion">

            <!-- AGREGAR AQUÍ LA DESCRIPCIÓN OFICIAL -->
            <p>
                [AGREGAR DESCRIPCIÓN DEL EVENTO]
            </p>

            <h3>Objetivo</h3>

            <!-- AGREGAR AQUÍ EL OBJETIVO DEL EVENTO -->
            <p>
                [AGREGAR OBJETIVO Y PROPÓSITO DE LA CAMINATA]
            </p>

        </div>

    </div>

</section>


<!-- =====================================
     INFORMACIÓN GENERAL
     ===================================== -->

<section class="evento-seccion evento-fondo" id="informacion">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">PREPARA TU EXPERIENCIA</span>

            <h2>Información del evento</h2>

            <p>
                Conoce los detalles para participar en El Gran Abrazo.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">📅</span>
                    <h3>Fecha</h3>

                    <!-- AGREGAR FECHA -->
                    <p>29 de noviembre del 2026</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🕒</span>
                    <h3>Horario</h3>

                    <!-- AGREGAR HORARIO -->
                    <p>Inicia a las 12 P.M.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">📍</span>
                    <h3>Ubicación</h3>

                    <!-- AGREGAR UBICACIÓN -->
                    <p>Arrancamos en el Cristo de la Bartola</p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =====================================
     DETALLES DE LA CAMINATA
     ===================================== -->

<section class="evento-seccion" id="recorrido">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">EL RECORRIDO</span>

            <h2>Una caminata por nuestra comunidad</h2>

            <p>
                Conoce los detalles del recorrido de El Gran Abrazo.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🚶</span>
                    <h3>Distancia</h3>
                    <p>7 kilómetros</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🏁</span>
                    <h3>Punto de partida</h3>

                    <!-- AGREGAR PUNTO DE PARTIDA -->
                    <p>Cristo de la Bartola</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">📍</span>
                    <h3>Punto de llegada</h3>

                    <!-- AGREGAR PUNTO DE LLEGADA -->
                    <p>Cristo del Consuelo</p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =====================================
     GALERÍA FOTOGRÁFICA
     ===================================== -->

<section class="evento-seccion evento-fondo" id="galeria">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">REVIVE LA EXPERIENCIA</span>

            <h2>Galería fotográfica</h2>

            <p>
                Conoce algunos momentos de El Gran Abrazo.
            </p>
        </div>

        <div class="row g-4">

            <!-- FOTOGRAFÍA 1 -->
            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/gran-abrazo/REEMPLAZAR-FOTO-1.jpg"
                         alt="Fotografía de El Gran Abrazo" />
                </div>
            </div>

            <!-- FOTOGRAFÍA 2 -->
            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/gran-abrazo/REEMPLAZAR-FOTO-2.jpg"
                         alt="Participantes de El Gran Abrazo" />
                </div>
            </div>

            <!-- FOTOGRAFÍA 3 -->
            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/gran-abrazo/REEMPLAZAR-FOTO-3.jpg"
                         alt="Momentos de la caminata" />
                </div>
            </div>

        </div>

        <!--
        Si necesitas más fotografías, puedes duplicar
        uno de los bloques anteriores y cambiar su ruta.
        -->

    </div>

</section>


<!-- =====================================
     VIDEO DEL EVENTO
     ===================================== -->

<section class="evento-seccion" id="video">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">VIVE LA EXPERIENCIA</span>

            <h2>El Gran Abrazo en video</h2>

            <p>
                Conoce más sobre esta experiencia a través de nuestro video.
            </p>
        </div>

        <div class="evento-video">

            <video controls preload="metadata" playsinline>
                <source src="~/videos/gran-abrazo/REEMPLAZAR-VIDEO.mp4"
                        type="video/mp4" />

                Tu navegador no admite la reproducción de video.
            </video>

        </div>

    </div>

</section>
