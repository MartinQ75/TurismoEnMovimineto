@{
    ViewData["Title"] = "Festival del Globo";
}

<!-- =====================================
     PORTADA DEL EVENTO
     ===================================== -->

<section class="evento-hero">
    <div class="evento-hero-imagen"
         style="background-image: linear-gradient(rgba(15, 45, 35, 0.60), rgba(15, 45, 35, 0.60)), url('/images/Globos/REEMPLAZAR-IMAGEN-PORTADA.jpg');">

        <div class="container evento-hero-contenido">

            <span class="evento-etiqueta">FESTIVAL</span>

            <h1>Festival del globo</h1>

            <!-- AGREGAR FRASE REPRESENTATIVA -->
            <p>
                [AGREGAR FRASE O DESCRIPCIÓN BREVE DEL FESTIVAL]
            </p>

            <a href="#informacion" class="btn btn-principal">
                Conocer el festival
            </a>

        </div>
    </div>
</section>


<!-- =====================================
     DESCRIPCIÓN Y OBJETIVO
     ===================================== -->

<section class="evento-seccion" id="descripcion">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">CONOCE EL FESTIVAL</span>
            <h2>¿Qué es el Festival del Globo?</h2>
        </div>

        <div class="evento-descripcion">

            <!-- AGREGAR DESCRIPCIÓN OFICIAL -->
            <p>
                [AGREGAR DESCRIPCIÓN DEL FESTIVAL]
            </p>

            <h3>Objetivo</h3>

            <!-- AGREGAR OBJETIVO -->
            <p>
                [AGREGAR OBJETIVO Y PROPÓSITO DEL FESTIVAL]
            </p>

        </div>

    </div>

</section>


<!-- =====================================
     INFORMACIÓN GENERAL
     ===================================== -->

<section class="evento-seccion evento-fondo" id="informacion">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">PREPARA TU VISITA</span>
            <h2>Información del festival</h2>
            <p>
                Consulta los detalles para disfrutar de esta experiencia.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">📅</span>
                    <h3>Fecha</h3>
                    <p>[AGREGAR FECHA DEL FESTIVAL]</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🕒</span>
                    <h3>Horario</h3>
                    <p>[AGREGAR HORARIO DEL FESTIVAL]</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">📍</span>
                    <h3>Ubicación</h3>
                    <p>[AGREGAR UBICACIÓN DEL FESTIVAL]</p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =====================================
     ACTIVIDADES
     ===================================== -->

<section class="evento-seccion" id="actividades">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">¿QUÉ PODRÁS DISFRUTAR?</span>
            <h2>Actividades del festival</h2>
            <p>
                [AGREGAR UNA INTRODUCCIÓN A LAS ACTIVIDADES]
            </p>
        </div>

        <div class="row g-4">

            <!-- ACTIVIDAD 1 -->
            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🪁</span>
                    <h3>[NOMBRE DE ACTIVIDAD]</h3>
                    <p>[DESCRIPCIÓN DE LA ACTIVIDAD]</p>
                </div>
            </div>

            <!-- ACTIVIDAD 2 -->
            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🎨</span>
                    <h3>[NOMBRE DE ACTIVIDAD]</h3>
                    <p>[DESCRIPCIÓN DE LA ACTIVIDAD]</p>
                </div>
            </div>

            <!-- ACTIVIDAD 3 -->
            <div class="col-md-4">
                <div class="evento-dato">
                    <span class="evento-icono">🎉</span>
                    <h3>[NOMBRE DE ACTIVIDAD]</h3>
                    <p>[DESCRIPCIÓN DE LA ACTIVIDAD]</p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =====================================
     GALERÍA FOTOGRÁFICA
     ===================================== -->

<section class="evento-seccion evento-fondo" id="galeria">

    <div class="container">

        <div class="evento-encabezado">
            <span class="texto-etiqueta">REVIVE LA EXPERIENCIA</span>
            <h2>Galería fotográfica</h2>
            <p>
                Descubre algunos momentos del Festival del Globo.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/Globo/REEMPLAZAR-FOTO-1.jpg"
                         alt="Festival de Globo" />
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/Globo/REEMPLAZAR-FOTO-2.jpg"
                         alt="Globo durante el festival" />
                </div>
            </div>

            <div class="col-md-4">
                <div class="evento-galeria-item">
                    <img src="~/images/Globo/REEMPLAZAR-FOTO-3.jpg"
                         alt="Actividades del Festival de Globo" />
                </div>
            </div>

        </div>

    </div>

</section>
